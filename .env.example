# Copy to .env and fill in. Never commit the real .env -- it's gitignored.

DASHBOARD_PASSWORD=

# From alpaca.markets dashboard -> API Keys -> generate a PAPER key pair.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Only needed if paper_trade_alpaca.py runs as its own separate Railway service (Cron
# Schedule) from the web dashboard -- see webapp/main.py's module docstring. Leave both
# unset for local runs; the script falls back to writing local files.
DASHBOARD_URL=
AGENT_REPORT_TOKEN=

# Optional: a push notification the moment a real order is submitted. ntfy.sh needs no
# account on either end -- pick a random unguessable topic name (it doubles as the access
# control, since ntfy.sh is a public service), then subscribe to it in the ntfy app or at
# https://ntfy.sh/<topic> in a browser. Leave unset for no notifications.
NTFY_TOPIC=
